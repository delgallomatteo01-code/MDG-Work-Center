{
  "name": "matteo-work-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Matteo Work center — workspace personale per task, progetti, scadenze, note e report.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "express": "^4.22.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "multer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
