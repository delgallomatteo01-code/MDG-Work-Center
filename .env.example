# Credenziali del proprietario del workspace (unico utente).
OWNER_EMAIL=matteo@example.com
# Usa OWNER_PASSWORD_HASH (consigliato, genera con: npm run hash-password -- "la-tua-password")
# oppure OWNER_PASSWORD in chiaro solo per sviluppo locale.
OWNER_PASSWORD_HASH=
OWNER_PASSWORD=
# Porta del server API / produzione
PORT=3001
# Cartella dati (database SQLite + file caricati)
DATA_DIR=./data
# true in produzione dietro HTTPS
COOKIE_SECURE=false
